# Standalone opt-in service; this file is documentation, not loaded automatically.
IDENTITY_ENABLED=false
NODE_ENV=production
IDENTITY_PORT=8020
IDENTITY_ISSUER=https://auth.example.invalid
IDENTITY_ACCOUNT_BASE_URL=https://accounts.example.invalid
# Dedicated >=32-character service credential shared only with Python identity bridge.
IDENTITY_SERVICE_TOKEN=
# JSON array of independent >=32-character cookie signing keys, newest first.
IDENTITY_COOKIE_KEYS=
# Private RSA/EC JWKS JSON. Generate offline; never use RAgent JWT_SECRET.
IDENTITY_JWKS=
# Dedicated Postgres database/schema permissions for protocol artifacts only.
IDENTITY_DATABASE_URL=
# Static confidential first-party clients; exact https redirect_uris, unique secrets >=32 chars.
IDENTITY_CLIENTS=[{"client_id":"mt-review","client_secret":"REPLACE_WITH_RANDOM_CLIENT_SECRET_32_PLUS","redirect_uris":["https://review.example.invalid/oidc/callback"]},{"client_id":"mt-convert","client_secret":"REPLACE_WITH_ANOTHER_RANDOM_SECRET_32_PLUS","redirect_uris":["https://convert.example.invalid/oidc/callback"]}]

# Serve the existing RAgent UI at this same-origin path via reverse proxy.
IDENTITY_INTERACTION_UI_PATH=/identity-login
CLOUDBASE_ENV_ID=
