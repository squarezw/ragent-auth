# Documentation only. Generate compose.env from an external deployment JSON.
# Every endpoint, network and host mapping below must be supplied explicitly.
IDENTITY_ENABLED=false
IDENTITY_PUBLISH_PORT=8020
IDENTITY_IMAGE=example-identity:reviewed-commit
IDENTITY_ISSUER=https://auth.example.invalid
IDENTITY_ACCOUNT_BASE_URL=https://api.example.invalid
IDENTITY_SECRET_DIR=/etc/example-identity/secrets
IDENTITY_DOCKER_NETWORK=example-private-network
IDENTITY_BRIDGE_HOST=api.example.invalid
IDENTITY_BRIDGE_GATEWAY=192.0.2.1
CLOUDBASE_ENV_ID=replace-with-environment-id
# Secret directory: service-token, cookie-keys.json, private-jwks.json,
# clients.json, database-url. Never put secret values in this env file.
